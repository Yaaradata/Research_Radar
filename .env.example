# Existing Amazon RDS/Postgres
# Either DATABASE_URL or PG_DSN is accepted by scripts.
DATABASE_URL=postgresql://research_radar_user:CHANGE_ME@YOUR_RDS_ENDPOINT:5432/YOUR_DB?sslmode=require
PG_DSN=

# Existing Inoreader integration
INOREADER_ACCESS_TOKEN=
# Optional OAuth refresh fallback (used if access token is missing/expired)
INOREADER_CLIENT_ID=
INOREADER_CLIENT_SECRET=
INOREADER_REFRESH_TOKEN=
INOREADER_BASE_URL=https://www.inoreader.com
# Example: only the Research firehose folder
INOREADER_STREAM="user/-/label/10 RESEARCH - T3 Firehose"
INOREADER_BATCH_SIZE=100
INOREADER_LOOKBACK_DAYS=7
INOREADER_MAX_PAGES=50

# Optional fixture for a no-Inoreader smoke test
# INOREADER_FIXTURE=/opt/research-radar/config/inoreader_sample.json

OPENALEX_ENABLED=true
OPENALEX_API_KEY=
# Optional metadata only — OpenAlex ignores mailto for rate pools now.
OPENALEX_MAILTO=commontech@theneural.ai
OPENALEX_WORKERS=1
OPENALEX_REQUEST_SLEEP=1.2
OPENALEX_MAX_RETRIES=5
OPENALEX_TITLE_SEARCH_ENABLED=false

CROSSREF_ENABLED=true
CROSSREF_MAILTO=commontech@theneural.ai

HTTP_USER_AGENT=TheNeural-Research-Radar/0.1
MIN_AI_RELEVANCE_FOR_ENRICHMENT=5.0
# Calibrated for empty people watchlist (person weight auto-redistributed).
MIN_INTRINSIC_CANDIDATE_SCORE=5.5
SCORE_INCLUDE_PERSON_SIGNAL=auto
ARXIV_WORKERS=4
PIPELINE_WORKERS=4
ARXIV_COMMIT_EVERY=10
ARXIV_REQUEST_SLEEP=1.0
